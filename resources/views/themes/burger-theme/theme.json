{
  "name": "برجر كلاسيك",
  "author": "منصة المطاعم",
  "version": "1.0.0",
  
  "default_settings": {
    "primary_color": "#FF6B35",
    "secondary_color": "#FFFFFF",
    "background_color": "#1A1A1A",
    "font_family": "Tajawal",
    "header_style": "sticky",
    "show_hero_banner": true,
    "hero_title": "أشهى البرجر في المدينة",
    "hero_subtitle": "تجربة طعم لا تُقاوم",
    "border_radius": "0.5rem",
    "card_style": "elevated"
  },

  "allowed_variables": {
    "primary_color": {
      "type": "color",
      "label": "اللون الرئيسي",
      "description": "يُستخدم في الأزرار والروابط",
      "default": "#FF6B35"
    },
    "secondary_color": {
      "type": "color",
      "label": "اللون الثانوي",
      "default": "#FFFFFF"
    },
    "background_color": {
      "type": "color",
      "label": "لون الخلفية",
      "default": "#1A1A1A"
    },
    "font_family": {
      "type": "select",
      "label": "نوع الخط",
      "options": {
        "Tajawal": "Tajawal (عصري)",
        "Cairo": "Cairo (واضح)",
        "Almarai": "Almarai (أنيق)"
      },
      "default": "Tajawal"
    },
    "header_style": {
      "type": "select",
      "label": "شكل القائمة العلوية",
      "options": {
        "sticky": "ثابت في الأعلى",
        "transparent": "شفاف فوق الصورة"
      },
      "default": "sticky"
    },
    "show_hero_banner": {
      "type": "boolean",
      "label": "إظهار البانر الرئيسي",
      "default": true
    },
    "hero_title": {
      "type": "text",
      "label": "عنوان البانر",
      "default": "أشهى البرجر في المدينة"
    },
    "hero_subtitle": {
      "type": "text",
      "label": "العنوان الفرعي",
      "default": "تجربة طعم لا تُقاوم"
    },
    "border_radius": {
      "type": "select",
      "label": "انحناء الحواف",
      "options": {
        "0": "مربع",
        "0.25rem": "خفيف",
        "0.5rem": "متوسط",
        "1rem": "دائري"
      },
      "default": "0.5rem"
    },
    "card_style": {
      "type": "select",
      "label": "شكل البطاقات",
      "options": {
        "elevated": "بارزة بظل",
        "flat": "مسطحة بإطار"
      },
      "default": "elevated"
    }
  }
}